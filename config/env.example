# APPTEST configuration template (NO REAL SECRETS)
# The following public URL is also preconfigured in wrangler.toml.
APPTEST_PUBLIC_URL=https://apptest.mabrigkorie.org

# OFF by default. Enable each service later in Cloudflare Pages > Settings > Variables and Secrets.
AI_ENABLED=false
EMAIL_ENABLED=false

# The names below are reserved for future encrypted secrets in Cloudflare.
# Do not commit actual values. A blank value here is not a usable credential.
OPENROUTER_API_KEY=
APPTEST_ADMIN_TOKEN=
RESEND_API_KEY=
TURNSTILE_SECRET=

# Non-secret settings requiring confirmation before enabling email.
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
TURNSTILE_SITE_KEY=

# Cloudflare Pages project name: apptest
# Publish directory: public
# GitHub repo: mabrig1/APPTEST
# Optional local dev: copy this file to .dev.vars and fill locally.
# .dev.vars is gitignored; never commit keys or customer data.
